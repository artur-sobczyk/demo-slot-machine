{
  "name": "slot-machine",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Slot machine serverless application",
  "scripts": {
    "dev": "node local/dev-server.js",
    "seed-local": "node local/seed-local.js",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:integration": "cd backend && npm run test:integration",
    "deploy-backend": "cd backend && sam build && sam deploy",
    "deploy-frontend": "powershell -ExecutionPolicy Bypass -File frontend/deploy.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "express": "^4.21.0"
  }
}
